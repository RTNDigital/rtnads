# Copy to .env and adjust for your deployment. docker-compose reads these via the
# `environment:` block (or pass with `--env-file`).

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://rtnads:rtnads@db:5432/rtnads

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787

# ── Demo mode (local / evaluation) ────────────────────────────────────────────
# Fixed Optimizer principal (no IdP) + auto-loaded demo warehouse. Set both OFF
# for production.
BFF_DEV_PRINCIPAL=1
DEMO_SEED=1
DEMO_CLIENT_ID=cccccccc-0000-0000-0000-000000000001

# ── Production auth (OIDC/JWT) ────────────────────────────────────────────────
# Unset BFF_DEV_PRINCIPAL and set DEMO_SEED=0, then configure your IdP. The
# principal + tenant come from the verified token, never the client.
# BFF_OIDC_ISSUER=https://your-idp.example.com/
# BFF_OIDC_AUDIENCE=rtn-ads-intelligence
# One of:
# BFF_OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json   # RS256
# BFF_JWT_HS256_SECRET=change-me                                          # HS256
# Optional claim overrides:
# BFF_OIDC_CLIENT_ID_CLAIM=client_id
# BFF_OIDC_ROLES_CLAIM=roles
