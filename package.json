{
  "name": "rtnads",
  "private": true,
  "version": "0.1.0",
  "description": "RTN Ads Intelligence — agency-specific advertising decision intelligence platform",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "db:migrate": "node --experimental-strip-types db/migrate.ts",
    "db:seed": "node --experimental-strip-types db/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
