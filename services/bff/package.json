{
  "name": "@rtnads/bff",
  "version": "0.1.0",
  "description": "Backend-for-Frontend — REST ingress with RBAC + tenancy for the operator UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node dist/main.js",
    "seed:recommendation": "node scripts/seed-recommendation.mjs"
  },
  "dependencies": {
    "@rtnads/action-executor": "workspace:*",
    "@rtnads/contracts": "workspace:*",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
